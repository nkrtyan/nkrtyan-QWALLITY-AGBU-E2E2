# 2. Remove 0th, 4th and 5th elements from a list
numbers = [10, 20, 30, 40, 50, 60, 70]
result = []
for i in range(len(numbers)):
    if i not in [0, 4, 5]:
        result.append(numbers[i])
print(result)
# Nel, correct

