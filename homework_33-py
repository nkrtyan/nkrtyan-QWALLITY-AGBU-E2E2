from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys


def test_python_search(browser):
    if browser == "chrome":
        driver = webdriver.Chrome()
    elif browser == "edge":
        driver = webdriver.Edge()
    else:
        raise ValueError("Unsupported browser")

    try:
        driver.get("https://www.python.org")

        search = driver.find_element(By.ID, "id-search-field")
        search.send_keys("BlaBla")
        search.send_keys(Keys.ENTER)

        result = driver.find_element(
            By.XPATH,
            "//*[contains(text(), 'No results found')]"
        )

        assert "No results found" in result.text

        print(f"{browser}: Test passed")

    finally:
        driver.quit()


test_python_search("chrome")
test_python_search("edge")





    
                    